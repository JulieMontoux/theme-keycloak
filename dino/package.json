{
  "name": "dino",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "keycloakify": "^11.8.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prestart": "keycloakify update-kc-gen && keycloakify copy-keycloak-resources-to-public",
    "start": "react-scripts start",
    "prestorybook": "npm run prestart",
    "storybook": "storybook dev -p 6006",
    "prebuild": "keycloakify update-kc-gen",
    "build": "react-scripts build",
    "postbuild": "rimraf build/keycloakify-dev-resources",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "format": "prettier . --write",
    "build-storybook": "storybook build"
  },
  "keycloakify": {
    "accountThemeImplementation": "none",
    "projectBuildDirPath": "build",
    "staticDirPathInProjectBuildDirPath": "static",
    "publicDirPath": "public"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
